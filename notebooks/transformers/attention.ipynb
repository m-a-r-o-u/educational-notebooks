   "id": "attention-scores",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "query = np.array([[1.0, 0.0]])\n",
    "key = np.array([[1.0, 0.0], [0.0, 1.0]])\n",
    "query @ key.T"
   ]
  }
